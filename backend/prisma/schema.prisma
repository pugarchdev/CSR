datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
  PENDING_APPROVAL
  PENDING_ACTIVATION
}

enum OrganizationKind {
  NGO
  CSR_COMPANY
  GOVERNMENT_DEPARTMENT
  IMPLEMENTING_AGENCY
  PORTAL_ADMIN_ORG
}

enum OrganizationStatus {
  REGISTERED
  PROFILE_INCOMPLETE
  DOCUMENTS_PENDING
  UNDER_VERIFICATION
  CLARIFICATION_REQUIRED
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ProjectType {
  NGO_PROPOSAL
  MARKETPLACE_REQUIREMENT
  CONVERGENCE_FRAMEWORK
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  MARKETPLACE_LISTED
  AGREEMENT_SIGNED
  EXECUTION_STARTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  FUNDED
}

enum MilestoneStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  IN_PROGRESS
  SUBMITTED_FOR_VERIFICATION
  VERIFIED
  REJECTED
  CHANGES_REQUIRED
  COMPLETED
}

enum MilestoneCreatorType {
  IMPLEMENTING_AGENCY
  CORPORATE
  GOVERNMENT_DEPARTMENT
}

enum MouStatus {
  NOT_INITIATED
  DRAFT
  CORPORATE_REVIEW
  GOVT_REVIEW
  LEGAL_REVIEW
  REVISION_REQUESTED
  APPROVED
  SIGNING_IN_PROGRESS
  SIGNED
  EXPIRED
  TERMINATED
}

enum MouSigningType {
  DIGITAL
  PHYSICAL
}

enum VerificationModuleType {
  GST
  AADHAAR
  PAN
  CIN
  UDYAM
  DIGILOCKER
}

enum VerificationRecordStatus {
  IN_PROGRESS
  OTP_SENT
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

enum GrievanceStatus {
  RAISED
  ACKNOWLEDGED
  LEVEL_1_REVIEW
  LEVEL_1_RESOLVED
  ESCALATED_TO_STATE_CELL
  LEVEL_2_RESOLVED
  ESCALATED_TO_JS_SECRETARY
  CLOSED
  REJECTED
}

enum FeasibilityResult {
  FEASIBLE
  PROCEED_WITH_CONDITIONS
  NOT_FEASIBLE
}

enum ChecklistAnswer {
  YES
  NO
  NA
}

enum RoleType {
  SYSTEM
  CUSTOM
}

enum RoleScope {
  GLOBAL
  ORGANIZATION
  ORGANIZATION_AND_CHILDREN
  DEPARTMENT
  DISTRICT
  DIVISION
  ASSIGNED
  OWN
  MULTI_ORGANIZATION
  PROJECT
  ASSIGNED_RESOURCE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum GovernmentOrganizationType {
  COLLECTORATE
  ZILLA_PARISHAD
  MUNICIPAL_CORPORATION
  SUB_DEPARTMENT
  STATE_CSR_CELL
}

enum GovernmentOrganizationLevel {
  MAIN
  SUB_DEPARTMENT
  STATE
}

enum PortalCaseType {
  CORPORATE_ENQUIRY
  GOVERNMENT_PITCH
  CORPORATE_PITCH_INTEREST
}

enum GeographicScope {
  SINGLE_DISTRICT
  MULTI_DISTRICT
  STATEWIDE
}

enum MembershipStatus {
  INVITED
  PENDING_FIRST_LOGIN
  ACTIVE
  SUSPENDED
  REVOKED
}

// =============================================================================
// USER, ROLE & ACCESS CONTROL ENGINE
// =============================================================================

model User {
  id                         String            @id @default(uuid())
  email                      String            @unique
  loginIdentifier            String?           @unique
  passwordHash               String
  accountStatus              UserAccountStatus @default(PENDING_ACTIVATION)
  isVerified                 Boolean           @default(false)
  tokenVersion               Int               @default(1)
  mustResetPassword          Boolean           @default(false)
  temporaryPasswordExpiresAt DateTime?
  passwordChangedAt          DateTime?
  invitationAcceptedAt       DateTime?

  // Basic Metadata
  firstName   String?
  lastName    String?
  designation String?
  mobile      String? @unique

  // Primary Role Reference (Strict Integer ID: 1-9 for System Roles, 10+ for Dynamic Roles)
  roleId Int?
  role   Role? @relation("UserPrimaryRole", fields: [roleId], references: [id], onDelete: SetNull)

  // Organization Context
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Sub-login Hierarchy
  parentUserId String?
  parentUser   User?   @relation("UserHierarchy", fields: [parentUserId], references: [id], onDelete: SetNull)
  subUsers     User[]  @relation("UserHierarchy")

  // Soft Delete & Timestamps
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // System Relations
  userRoles            UserOrganizationRole[]
  roleAssignments      UserRoleAssignment[]   @relation("UserRoleAssignments")
  givenRoleAssignments UserRoleAssignment[]   @relation("AssignedByRoleAssignments")
  officerProfile       UserOfficerProfile?
  districtMappings     DistrictNodalMapping[] @relation("NodalUser")
  assignedByMappings   DistrictNodalMapping[] @relation("AssignedByNodalUser")
  sessions             Session[]
  auditLogs            AuditLog[]             @relation("ActorAuditLogs")

  // Workflow Relations
  assignedProjects        ProjectAssignment[]         @relation("AssignedToUser")
  givenAssignments        ProjectAssignment[]         @relation("AssignedByUser")
  dncDistricts            DistrictDncAssignment[]     @relation("DistrictDncUser")
  assignedDncDistricts    DistrictDncAssignment[]     @relation("DistrictDncAssignedBy")
  grievancesRaised        Grievance[]                 @relation("GrievancesRaised")
  grievanceLogs           GrievanceActionLog[]        @relation("GrievanceActor")
  inspections             ProjectInspection[]         @relation("InspectorUser")
  helpdeskRaised          HelpdeskQuery[]             @relation("HelpdeskRaised")
  helpdeskResolved        HelpdeskQuery[]             @relation("HelpdeskResolved")
  verificationRecords     VerificationRecord[]        @relation("InitiatedBy")
  messages                Message[]
  dnoNominations          DnoNomination[]             @relation("DnoNominatedUser")
  verifiedDnoNominations  DnoNomination[]             @relation("DnoVerifiedBy")
  departmentHeadedOrgs    Organization[]              @relation("OrgDepartmentHead")
  organizationMemberships OrganizationMembership[]
  rmProfile               RelationshipManagerProfile?
  assignedPortalCases     PortalCase[]                @relation("PortalCaseAssignedRm")
  corporateNgoAccesses    CorporateNgoAccess[]

  @@index([organizationId])
  @@index([roleId])
  @@index([parentUserId])
  @@index([email, accountStatus])
  @@index([roleId, organizationId])
  @@index([accountStatus])
  @@index([createdAt])
}

// Role Entity using Strict Integer IDs + Immutable Role Code
model Role {
  id           Int        @id @default(autoincrement())
  code         String?    @unique
  name         String
  displayName  String?
  description  String?
  type         RoleType   @default(CUSTOM)
  defaultScope RoleScope  @default(ORGANIZATION)
  status       RoleStatus @default(ACTIVE)
  isSystemRole Boolean    @default(false)
  isProtected  Boolean    @default(false)
  version      Int        @default(1)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relations
  users              User[]                 @relation("UserPrimaryRole")
  userRoles          UserOrganizationRole[]
  roleAssignments    UserRoleAssignment[]
  rolePermissions    RolePermission[]
  parentRoles        RoleHierarchy[]        @relation("ParentRoleHierarchy")
  childRoles         RoleHierarchy[]        @relation("ChildRoleHierarchy")
  projectAssignments ProjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isSystemRole])
  @@index([code])
}

model Permission {
  id           String    @id @default(uuid())
  key          String    @unique
  description  String?
  module       String
  riskLevel    RiskLevel @default(LOW)
  isDelegable  Boolean   @default(false)
  dependencies String[]  @default([])
  createdAt    DateTime  @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// RoleHierarchy model is preserved for schema compatibility but explicitly disabled in application code
model RoleHierarchy {
  id           String   @id @default(uuid())
  parentRoleId Int
  childRoleId  Int
  parentRole   Role     @relation("ParentRoleHierarchy", fields: [parentRoleId], references: [id], onDelete: Cascade)
  childRole    Role     @relation("ChildRoleHierarchy", fields: [childRoleId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([parentRoleId, childRoleId])
  @@index([parentRoleId])
  @@index([childRoleId])
}

model UserOrganizationRole {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         Int
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
}

model UserRoleAssignment {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  roleId         Int
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scopeType      RoleScope?       @default(ORGANIZATION)
  districtCode   String?
  divisionCode   String?
  departmentId   String?
  projectId      String?
  project        Project?         @relation("ProjectRoleAssignments", fields: [projectId], references: [id], onDelete: SetNull)
  status         AssignmentStatus @default(ACTIVE)
  validFrom      DateTime         @default(now())
  validUntil     DateTime?
  assignedById   String?
  assignedBy     User?            @relation("AssignedByRoleAssignments", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, status])
  @@index([roleId])
  @@index([organizationId])
  @@index([districtCode])
  @@index([projectId])
}

model UserOfficerProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  employeeId    String? @unique
  designation   String?
  department    String?
  district      String?
  taluka        String?
  officeAddress String?
  mobile        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district])
  @@index([employeeId])
}

// =============================================================================
// UNIFIED ORGANIZATION ENGINE
// =============================================================================

model Organization {
  id                     String           @id @default(uuid())
  kind                   OrganizationKind
  name                   String
  legalName              String?
  displayName            String?
  registrationNumber     String?
  registrationNumberHash String?          @unique
  cin                    String?
  cinHash                String?          @unique
  pan                    String?
  panHash                String?          @unique
  gstin                  String?
  gstinHash              String?          @unique

  officialIdentifierType   String?
  officialIdentifierNumber String?

  parentOrganizationId     String?
  parentOrganization       Organization?  @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations       Organization[] @relation("OrgHierarchy")
  parentRegistrationCode   String?        @unique
  parentRelationshipStatus String         @default("NONE") // NONE | PENDING_VERIFICATION | VERIFIED | REJECTED | CHANGE_REQUESTED

  governmentType         GovernmentOrganizationType?
  governmentLevel        GovernmentOrganizationLevel?
  operationalNodalUserId String?
  organizationCode       String?

  departmentHeadUserId String?
  departmentHeadUser   User?   @relation("OrgDepartmentHead", fields: [departmentHeadUserId], references: [id], onDelete: SetNull)

  dnoAuthority String @default("DEPARTMENT") // DEPARTMENT | PARENT_ORGANIZATION | SUPER_ADMIN

  // Contact & Location
  officialEmail           String?
  officialOfficeEmail     String?
  officialPhone           String?
  officialOfficePhone     String?
  website                 String?
  address                 String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  registeredOfficeAddress String?
  corporateOfficeAddress  String?
  officialEmailDomain     String?
  yearOfIncorporation     Int?
  companyType             String?
  mcaVerificationStatus   String?
  companyStatus           String?
  state                   String  @default("Maharashtra")
  district                String?
  taluka                  String?
  pincode                 String?

  status               OrganizationStatus @default(REGISTERED)
  clarificationRemarks String?
  rejectionReason      String?

  // Specialized 1:1 Extension Profiles
  csrCompanyProfile CSRCompanyProfile?
  ngoProfile        NGOProfile?
  govDeptProfile    GovDepartmentProfile?

  // System Relations
  users                    User[]
  projects                 Project[]                         @relation("OrganizationProjects")
  parentOrgProjects        Project[]                         @relation("ParentOrgProjects")
  deptOrgProjects          Project[]                         @relation("DeptOrgProjects")
  documents                Document[]
  bankAccounts             BankAccount[]
  roles                    Role[]
  userRoles                UserOrganizationRole[]
  roleAssignments          UserRoleAssignment[]
  agencySubLogins          AgencySubLogin[]                  @relation("OrganizationSubLogins")
  subDepartments           SubDepartment[]
  dnoNominations           DnoNomination[]
  departmentDnoNominations DnoNomination[]                   @relation("DnoDeptOrg")
  requestedRelationships   OrganizationRelationship[]        @relation("ChildOrgRel")
  childRelationships       OrganizationRelationship[]        @relation("ParentOrgRel")
  memberships              OrganizationMembership[]
  onboardingApplications   GovernmentOnboardingApplication[]
  governmentAssignments    GovernmentAssignment[]            @relation("GovernmentAssignmentOrganization")
  corporateNgoMemberships  CorporateNgoMembership[]          @relation("CorporateNgoCorporate")
  ngoCorporateMemberships  CorporateNgoMembership[]          @relation("CorporateNgoMaster")

  // Soft Delete & Timestamps
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([kind])
  @@index([status])
  @@index([district])
  @@index([kind, status])
  @@index([officialEmail])
  @@index([createdAt])
  @@index([registrationNumberHash])
  @@index([cinHash])
  @@index([panHash])
  @@index([gstinHash])
}

model CSRCompanyProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  csrRegistrationNo       String?
  annualCsrBudget         Decimal? @db.Decimal(15, 2)
  currentYearCsrBudget    Decimal? @db.Decimal(15, 2)
  netWorth                Decimal? @db.Decimal(15, 2)
  turnover                Decimal? @db.Decimal(15, 2)
  netProfit               Decimal? @db.Decimal(15, 2)
  averageNetProfit        Decimal? @db.Decimal(15, 2)
  csrObligationAmount     Decimal? @db.Decimal(15, 2)
  unspentCsrAmount        Decimal? @db.Decimal(15, 2)
  twoPercentCsrObligation Decimal? @db.Decimal(15, 2)
  financialYear           String?
  csrApplicable           Boolean?

  preferredDistricts         String[]
  preferredSectors           String[]
  preferredDivisions         String[] @default([])
  preferredCities            String[] @default([])
  preferredTalukas           String[] @default([])
  preferredProjectSize       String?
  minFundingAmount           Decimal? @db.Decimal(15, 2)
  maxFundingAmount           Decimal? @db.Decimal(15, 2)
  fundingPreference          String?
  implementationPreference   String?
  preferredBeneficiaryGroups String?
  sdgFocusAreas              String?

  csrHeadName   String?
  csrHeadEmail  String?
  csrHeadMobile String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NGOProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  darpanNumber      String?
  darpanNumberHash  String? @unique
  csr1Number        String?
  csr1NumberHash    String? @unique
  certificate12AUrl String?
  certificate80GUrl String?
  fcraDetails       String?

  yearEstablished  Int?
  areasOfOperation String[]
  csrSectors       String[]
  impactStatistics Json?

  riskScores RiskScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([darpanNumberHash])
  @@index([csr1NumberHash])
}

model GovDepartmentProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orgType            String?
  adminLevel         String?
  parentOrganization String?
  officialRegNo      String?
  deptOfficeCode     String?
  departmentType     String?
  parentDepartment   String?
  departmentCode     String?

  nodalOfficerName        String?
  nodalOfficerDesignation String?
  nodalOfficerEmail       String?
  nodalOfficerMobile      String?
  employeeId              String?
  representativeMobile    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubDepartment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                 String
  code                 String?
  type                 String?
  description          String?
  officeAddress        String?
  officialEmail        String?
  officialPhone        String?
  departmentHead       String?
  departmentHeadEmail  String?
  departmentHeadMobile String?
  dnoName              String?
  status               String  @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dnoNominations DnoNomination[]

  @@index([organizationId])
  @@index([status])
}

model OrganizationRelationship {
  id                   String       @id @default(uuid())
  childOrganizationId  String
  childOrganization    Organization @relation("ChildOrgRel", fields: [childOrganizationId], references: [id], onDelete: Cascade)
  parentOrganizationId String
  parentOrganization   Organization @relation("ParentOrgRel", fields: [parentOrganizationId], references: [id], onDelete: Cascade)

  status          String    @default("PENDING") // PENDING | VERIFIED | REJECTED | CHANGE_REQUESTED
  requestedAt     DateTime  @default(now())
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childOrganizationId, parentOrganizationId])
  @@index([childOrganizationId])
  @@index([parentOrganizationId])
  @@index([status])
}

model DnoNomination {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentOrganizationId String?
  departmentOrganization   Organization? @relation("DnoDeptOrg", fields: [departmentOrganizationId], references: [id], onDelete: SetNull)

  departmentId String?
  department   SubDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("DnoNominatedUser", fields: [userId], references: [id], onDelete: SetNull)

  firstName           String
  lastName            String
  officialDesignation String
  officialEmail       String
  officialMobile      String
  employeeId          String?

  scope               String @default("ORGANIZATION_WIDE") // ORGANIZATION_WIDE | DEPARTMENT_SPECIFIC
  appointmentOrderUrl String

  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  status          String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | ACTIVE | INACTIVE | REJECTED | EXPIRED | REVOKED
  rejectionReason String?

  verifiedById String?
  verifiedBy   User?     @relation("DnoVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([departmentOrganizationId])
  @@index([departmentId])
  @@index([status])
  @@index([officialEmail])
}

// =============================================================================
// UNIFIED PROJECT ENGINE
// =============================================================================

model Project {
  id          String      @id @default(uuid())
  projectCode String      @unique
  type        ProjectType @default(CONVERGENCE_FRAMEWORK)

  title       String
  description String   @db.Text
  sector      String
  focusArea   String?
  sdgGoals    String[]

  // Location
  state     String  @default("Maharashtra")
  district  String
  taluka    String
  village   String?
  latitude  Float?
  longitude Float?

  // Financial Precision
  approvedBudget  Decimal  @db.Decimal(15, 2)
  budgetRequested Decimal? @db.Decimal(15, 2)
  committedAmount Decimal  @default(0) @db.Decimal(15, 2)
  utilizedAmount  Decimal  @default(0) @db.Decimal(15, 2)

  // Beneficiaries
  beneficiaryCount     Int     @default(0)
  beneficiariesSummary String? @db.Text

  status ProjectStatus @default(DRAFT)

  // Ownership linkages
  organizationId String
  organization   Organization @relation("OrganizationProjects", fields: [organizationId], references: [id], onDelete: Restrict)

  parentOrganizationId String?
  parentOrganization   Organization? @relation("ParentOrgProjects", fields: [parentOrganizationId], references: [id], onDelete: SetNull)

  departmentOrganizationId String?
  departmentOrganization   Organization? @relation("DeptOrgProjects", fields: [departmentOrganizationId], references: [id], onDelete: SetNull)

  corporatePartnerId         String?
  implementingAgencyId       String?
  ngoId                      String?
  nodalOfficerUserId         String?
  dncUserId                  String?
  departmentAssignmentStatus String  @default("CONFIRMED") // PENDING | IDENTIFIED | CONFIRMED | REJECTED | REASSIGNMENT_REQUIRED
  approvalSourceEnquiryId    String? @unique
  approvalSourcePitchId      String? @unique

  // MoU & Governance Flags
  mouRequired Boolean   @default(true)
  mouStatus   MouStatus @default(NOT_INITIATED)

  // 23-Step Execution & Governance Engine Fields
  dnoAssignmentStatus         String    @default("NONE") // NONE | PENDING_ACCEPTANCE | ACCEPTED | REASSIGNMENT_REQUESTED
  dnoAcceptedAt               DateTime?
  dnoAcceptedById             String?
  dnoReassignmentReason       String?
  kickoffStatus               String    @default("PENDING") // PENDING | COMPLETED
  kickoffCompletedAt          DateTime?
  kickoffChecklist            Json?
  siteVerificationStatus      String    @default("PENDING") // PENDING | VERIFIED | PARTIALLY_VERIFIED | NOT_AVAILABLE
  siteInspectionReport        Json?
  implementationPlanStatus    String    @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  implementationPlanData      Json?
  finalDepartmentAcceptanceAt DateTime?
  finalDepartmentAcceptedById String?
  dncFinalReviewAt            DateTime?
  postCompletionPeriodMonths  Int?      @default(6)
  impactReportData            Json?
  archivedAt                  DateTime?

  // Lifecycle Dates
  startDate       DateTime?
  expectedEndDate DateTime?
  completedAt     DateTime?

  // Soft Delete & Timestamps
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Child Relations
  milestones              ProjectMilestone[]
  milestoneEvidences      MilestoneEvidence[]
  mouRecord               Mou?
  issues                  ProjectIssue[]
  communications          ProjectCommunicationLog[]
  implementingAgencies    ProjectImplementingAgency[]
  inspections             ProjectInspection[]
  documents               Document[]
  utilizationCertificates UtilizationCertificate[]
  grievances              Grievance[]
  mou                     StandardMou?
  agreements              Agreement[]
  agencySubLogins         AgencySubLogin[]               @relation("ProjectAgencySubLogins")
  districtDncAssignments  ProjectDistrictDncAssignment[]
  roleAssignments         UserRoleAssignment[]           @relation("ProjectRoleAssignments")

  @@index([district, sector])
  @@index([status])
  @@index([organizationId])
  @@index([type])
  @@index([status, type])
  @@index([nodalOfficerUserId])
  @@index([corporatePartnerId])
  @@index([implementingAgencyId])
  @@index([createdAt])
}

model ProjectMilestone {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  description    String? @db.Text
  sequenceOrder  Int     @default(1)
  targetAmount   Decimal @db.Decimal(15, 2)
  utilizedAmount Decimal @default(0) @db.Decimal(15, 2)

