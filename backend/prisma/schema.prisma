generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                                           String                         @id @default(uuid())
  organizationId                                                               String?
  email                                                                        String                         @unique
  passwordHash                                                                 String
  roleEnum                                                                     Role?                          @map("role")
  accountStatus                                                                UserAccountStatus              @default(ACTIVE)
  isSystemSeeded                                                               Boolean                        @default(false)
  isVerified                                                                   Boolean                        @default(false)
  otpCodeHash                                                                  String?
  otpExpiresAt                                                                 DateTime?
  refreshTokenHash                                                             String?
  createdAt                                                                    DateTime                       @default(now())
  updatedAt                                                                    DateTime                       @updatedAt
  ngoId                                                                        String?
  companyId                                                                    String?
  assignedDistrict                                                             String?
  iaAgencyName                                                                 String?
  iaApprovedByUserId                                                           String?
  iaCsr1Number                                                                 String?
  parentCorporateUserId                                                        String?
  roleId                                                                       String?
  AuditLog                                                                     AuditLog[]
  BeneficiaryProfile                                                           BeneficiaryProfile?
  ConvergenceProject_ConvergenceProject_corporateUserIdToUser                  ConvergenceProject[]           @relation("ConvergenceProject_corporateUserIdToUser")
  ConvergenceProject_ConvergenceProject_implementingAgencyUserIdToUser         ConvergenceProject[]           @relation("ConvergenceProject_implementingAgencyUserIdToUser")
  ConvergenceProject_ConvergenceProject_nodalOfficerUserIdToUser               ConvergenceProject[]           @relation("ConvergenceProject_nodalOfficerUserIdToUser")
  ConvergenceProjectInspection                                                 ConvergenceProjectInspection[]
  CorporateEnquiry_CorporateEnquiry_assignedRelationshipManagerIdToUser        CorporateEnquiry[]             @relation("CorporateEnquiry_assignedRelationshipManagerIdToUser")
  CorporateEnquiry_CorporateEnquiry_submittedByUserIdToUser                    CorporateEnquiry[]             @relation("CorporateEnquiry_submittedByUserIdToUser")
  CorporateEnquiryInteraction                                                  CorporateEnquiryInteraction[]
  assignedByMappings                                                           DistrictNodalMapping[]         @relation("AssignedByNodalUser")
  districtMappings                                                             DistrictNodalMapping[]         @relation("NodalUser")
  FeasibilityAssessment_FeasibilityAssessment_jsDecisionByIdToUser             FeasibilityAssessment[]        @relation("FeasibilityAssessment_jsDecisionByIdToUser")
  FeasibilityAssessment_FeasibilityAssessment_relationshipManagerIdToUser      FeasibilityAssessment[]        @relation("FeasibilityAssessment_relationshipManagerIdToUser")
  FundRelease                                                                  FundRelease[]
  GovernmentPitch_GovernmentPitch_assignedRelationshipManagerIdToUser          GovernmentPitch[]              @relation("GovernmentPitch_assignedRelationshipManagerIdToUser")
  GovernmentPitch_GovernmentPitch_submittedByUserIdToUser                      GovernmentPitch[]              @relation("GovernmentPitch_submittedByUserIdToUser")
  Grievance_Grievance_assignedNodalOfficerIdToUser                             Grievance[]                    @relation("Grievance_assignedNodalOfficerIdToUser")
  Grievance_Grievance_assignedStateCellUserIdToUser                            Grievance[]                    @relation("Grievance_assignedStateCellUserIdToUser")
  Grievance_Grievance_finalAuthorityUserIdToUser                               Grievance[]                    @relation("Grievance_finalAuthorityUserIdToUser")
  grievancesRaised                                                             Grievance[]                    @relation("GrievancesRaised")
  grievanceLogs                                                                GrievanceActionLog[]           @relation("GrievanceActor")
  helpdeskRaised                                                               HelpdeskQuery[]                @relation("HelpdeskRaised")
  helpdeskResolved                                                             HelpdeskQuery[]                @relation("HelpdeskResolved")
  messages                                                                     Message[]
  NGO_NGO_finalApprovedByIdToUser                                              NGO[]                          @relation("NGO_finalApprovedByIdToUser")
  NgoDocument_NgoDocument_uploadedByIdToUser                                   NgoDocument[]                  @relation("NgoDocument_uploadedByIdToUser")
  NgoDocument_NgoDocument_verifiedByIdToUser                                   NgoDocument[]                  @relation("NgoDocument_verifiedByIdToUser")
  NodalOfficerAppointment_NodalOfficerAppointment_appointedByJsIdToUser        NodalOfficerAppointment[]      @relation("NodalOfficerAppointment_appointedByJsIdToUser")
  NodalOfficerAppointment_NodalOfficerAppointment_nodalOfficerUserIdToUser     NodalOfficerAppointment[]      @relation("NodalOfficerAppointment_nodalOfficerUserIdToUser")
  Notification                                                                 Notification[]
  OnboardingApplication                                                        OnboardingApplication[]
  OnboardingQuery                                                              OnboardingQuery[]
  OnboardingStatusHistory                                                      OnboardingStatusHistory[]
  PaymentOrder                                                                 PaymentOrder[]
  givenAssignments                                                             ProjectAssignment[]            @relation("AssignedByUser")
  assignedProjects                                                             ProjectAssignment[]            @relation("AssignedToUser")
  ProjectDeliverableMilestone                                                  ProjectDeliverableMilestone[]
  QueryResponse                                                                QueryResponse[]
  Report                                                                       Report[]
  RiskFlag                                                                     RiskFlag[]
  RiskScore                                                                    RiskScore[]
  SLAEscalation_SLAEscalation_escalatedToUserIdToUser                          SLAEscalation[]                @relation("SLAEscalation_escalatedToUserIdToUser")
  SLAEscalation_SLAEscalation_responsibleUserIdToUser                          SLAEscalation[]                @relation("SLAEscalation_responsibleUserIdToUser")
  sessions                                                                     Session[]
  Company                                                                      Company?                       @relation(fields: [companyId], references: [id])
  User_User_iaApprovedByUserIdToUser                                           User?                          @relation("User_iaApprovedByUserIdToUser", fields: [iaApprovedByUserId], references: [id])
  other_User_User_iaApprovedByUserIdToUser                                     User[]                         @relation("User_iaApprovedByUserIdToUser")
  NGO_User_ngoIdToNGO                                                          NGO?                           @relation("User_ngoIdToNGO", fields: [ngoId], references: [id])
  User_User_parentCorporateUserIdToUser                                        User?                          @relation("User_parentCorporateUserIdToUser", fields: [parentCorporateUserId], references: [id])
  other_User_User_parentCorporateUserIdToUser                                  User[]                         @relation("User_parentCorporateUserIdToUser")
  role                                                                         OrganizationRole?              @relation("UserPrimaryRole", fields: [roleId], references: [id])
  UserInvitation_UserInvitation_createdByIdToUser                              UserInvitation[]               @relation("UserInvitation_createdByIdToUser")
  UserInvitation_UserInvitation_userIdToUser                                   UserInvitation[]               @relation("UserInvitation_userIdToUser")
  officerProfile                                                               UserOfficerProfile?
  userRoles                                                                    UserOrganizationRole[]
  UtilizationCertificate_UtilizationCertificate_uploadedByUserIdToUser         UtilizationCertificate[]       @relation("UtilizationCertificate_uploadedByUserIdToUser")
  UtilizationCertificate_UtilizationCertificate_verifiedByIdToUser             UtilizationCertificate[]       @relation("UtilizationCertificate_verifiedByIdToUser")
  UtilizationCertificate_UtilizationCertificate_verifiedByNodalOfficerIdToUser UtilizationCertificate[]       @relation("UtilizationCertificate_verifiedByNodalOfficerIdToUser")
  VerificationCheck                                                            VerificationCheck[]
  verificationRecords                                                          VerificationRecord[]           @relation("InitiatedBy")
  WorkflowHistory                                                              WorkflowHistory[]

  @@index([organizationId])
  @@index([parentCorporateUserId])
}

model Permission {
  id                         String                       @id @default(uuid())
  key                        String                       @unique
  description                String?
  module                     String
  createdAt                  DateTime                     @default(now())
  type                       PermissionType               @default(ACTION)
  groupId                    String?
  OrganizationRolePermission OrganizationRolePermission[]
  PermissionGroup            PermissionGroup?             @relation(fields: [groupId], references: [id])
  WorkflowAssignmentRule     WorkflowAssignmentRule[]
  WorkflowRule               WorkflowRule[]
  WorkflowTransition         WorkflowTransition[]
}

model RoleHierarchy {
  id           String           @id @default(uuid())
  parentRoleId String
  childRoleId  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime
  childRole    OrganizationRole @relation("ChildRoleHierarchy", fields: [childRoleId], references: [id], onDelete: Cascade)
  parentRole   OrganizationRole @relation("ParentRoleHierarchy", fields: [parentRoleId], references: [id], onDelete: Cascade)

  @@unique([parentRoleId, childRoleId])
}

model UserOrganizationRole {
  id             String           @id @default(uuid())
  userId         String
  roleId         String
  organizationId String?
  createdAt      DateTime         @default(now())
  companyId      String?
  Company        Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  role           OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([organizationId])
}

model UserOfficerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  fullName      String
  mobile        String?
  employeeId    String?
  designation   String?
  department    String?
  officeAddress String?
  district      String?
  taluka        String?
  block         String?
  office        String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([district])
  @@index([employeeId])
}

model Organization {
  id                          String                       @id @default(uuid())
  organizationType            OrganizationKind
  name                        String
  legalName                   String?
  displayName                 String?
  registrationNumber          String?
  cin                         String?
  llpin                       String?
  pan                         String?
  gst                         String?
  gstin                       String?
  departmentCode              String?
  parentDepartment            String?
  email                       String?
  officialEmail               String?
  phone                       String?
  officialPhone               String?
  website                     String?
  address                     String?
  stateId                     String?
  districtId                  String?
  talukaId                    String?
  villageId                   String?
  district                    String?
  taluka                      String?
  onboardingStatus            OrganizationOnboardingStatus @default(REGISTERED)
  verificationStatus          DocumentVerificationStatus   @default(UPLOADED)
  status                      OrganizationStatus           @default(ACTIVE)
  approvedBy                  String?
  approvedAt                  DateTime?
  rejectedBy                  String?
  rejectedAt                  DateTime?
  rejectionReason             String?
  clarificationRemarks        String?
  sourceNgoId                 String?
  sourceCompanyId             String?
  sourceBeneficiaryProfileId  String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  csrCompanyProfile           CSRCompanyProfile?
  GovernmentDepartmentProfile GovernmentDepartmentProfile?
  OnboardingReview            OnboardingReview[]
  OrganizationDocument        OrganizationDocument[]
  OrganizationRole            OrganizationRole[]
  userRoles                   UserOrganizationRole[]

  @@index([status])
  @@index([onboardingStatus])
  @@index([organizationType])
}

model CSRCompanyProfile {
  id                             String       @id @default(uuid())
  organizationId                 String       @unique
  companyType                    String?
  yearOfIncorporation            Int?
  mcaVerificationStatus          String?
  companyStatus                  String?
  registeredOfficeAddress        String?
  corporateOfficeAddress         String?
  officialEmailDomain            String?
  csrApplicable                  Boolean      @default(false)
  financialYear                  String?
  netWorth                       Decimal?
  turnover                       Decimal?
  netProfit                      Decimal?
  averageNetProfit               Decimal?
  csrObligationAmount            Decimal?
  twoPercentCsrObligation        Decimal?
  currentYearCsrBudget           Decimal?
  unspentCsrAmount               Decimal?
  ongoingProjectAmount           Decimal?
  csrCommitteeApplicable         Boolean      @default(false)
  csrCommitteeDetails            Json?
  csrCommitteeConstitutionDate   DateTime?
  csrPolicyApprovalDate          DateTime?
  boardApprovalStatus            String?
  csrHeadName                    String?
  csrHeadDesignation             String?
  csrHeadEmail                   String?
  csrHeadMobile                  String?
  financeOfficerName             String?
  financeOfficerDesignation      String?
  financeOfficerEmail            String?
  authorizedSignatoryName        String?
  authorizedSignatoryDesignation String?
  authorizedSignatoryEmail       String?
  authorizedSignatoryMobile      String?
  authorizationReferenceNumber   String?
  csrPolicyDocumentId            String?
  boardResolutionDocumentId      String?
  preferredDistricts             String[]
  preferredTalukas               String[]
  preferredSectors               String[]
  preferredProjectSize           String?
  preferredBeneficiaryGroups     String[]
  scheduleVIIFocusAreas          String[]
  sdgFocusAreas                  String[]
  esgFocusAreas                  String[]
  minFundingAmount               Decimal?
  maxFundingAmount               Decimal?
  fundingPreference              String?
  implementationPreference       String?
  declarationAccepted            Boolean      @default(false)
  declarationAcceptedAt          DateTime?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Project {
  id               String        @id @default(uuid())
  ngoId            String
  title            String
  description      String
  focusArea        String
  sdgGoal          String
  beneficiaryCount Int
  budgetRequested  Decimal
  budgetFunded     Decimal       @default(0)
  state            String        @default("Maharashtra")
  district         String
  taluka           String
  village          String?
  startDate        DateTime
  endDate          DateTime
  status           ProjectStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  Chat             Chat[]
  documents        Document[]
  MatchScore       MatchScore[]
  Milestone        Milestone[]
  NGO              NGO           @relation(fields: [ngoId], references: [id], onDelete: Cascade)
}

model Document {
  id             String    @id @default(uuid())
  organizationId String?
  title          String
  fileUrl        String
  fileType       String
  expiryDate     DateTime?
  ngoId          String?
  companyId      String?
  projectId      String?
  chatId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Chat           Chat?     @relation(fields: [chatId], references: [id])
  Company        Company?  @relation(fields: [companyId], references: [id])
  NGO            NGO?      @relation(fields: [ngoId], references: [id])
  project        Project?  @relation(fields: [projectId], references: [id])

  @@index([organizationId])
}

model VerificationRecord {
  id               String                   @id @default(uuid())
  entityType       VerificationEntityType
  entityId         String
  verificationType VerificationModuleType
  status           VerificationRecordStatus @default(IN_PROGRESS)
  attempt          Int                      @default(1)
  isLatest         Boolean                  @default(true)
  maskedIdentifier String?
  requestId        String                   @unique @default(uuid())
  transactionId    String?
  responseData     Json?
  encryptedPayload String?
  errorCode        String?
  errorMessage     String?
  responseTimeMs   Int?
  source           String?
  ipAddress        String?
  userAgent        String?
  initiatedById    String
  verifiedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime
  initiatedBy      User                     @relation("InitiatedBy", fields: [initiatedById], references: [id])

  @@index([transactionId])
  @@index([initiatedById])
  @@index([createdAt])
  @@index([entityType, entityId, verificationType, isLatest])
}

model RiskScore {
  id                     String     @id @default(uuid())
  ngoId                  String
  overallScore           Int
  riskLevel              RiskLevel
  legalRegistrationScore Int        @default(0)
  identitySignatoryScore Int        @default(0)
  financialScore         Int        @default(0)
  complianceScore        Int        @default(0)
  governanceScore        Int        @default(0)
  documentQualityScore   Int        @default(0)
  paymentBankScore       Int        @default(0)
  scoreBreakdown         Json?
  calculatedAt           DateTime   @default(now())
  calculatedById         String?
  riskFlags              RiskFlag[]
  User                   User?      @relation(fields: [calculatedById], references: [id])
  NGO                    NGO        @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@index([ngoId])
  @@index([riskLevel])
}

model RiskFlag {
  id              String    @id @default(uuid())
  riskScoreId     String
  flagType        String
  severity        String
  description     String
  recommendation  String?
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  User            User?     @relation(fields: [resolvedById], references: [id])
  riskScore       RiskScore @relation(fields: [riskScoreId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id                 String         @id @default(uuid())
  ngoId              String
  accountHolderName  String
  bankName           String
  branchName         String
  accountNumber      String
  ifscCode           String
  accountType        String
  isPrimary          Boolean        @default(false)
  isVerified         Boolean        @default(false)
  verificationMethod String?
  verifiedAt         DateTime?
  cancelledChequeUrl String?
  bankStatementUrl   String?
  verificationNotes  String?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  NGO                NGO            @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  FundRelease        FundRelease[]
  paymentOrders      PaymentOrder[]

  @@index([accountNumber])
  @@index([ngoId])
}

model PaymentOrder {
  id                 String               @id @default(uuid())
  orderNumber        String               @unique
  ngoId              String?
  companyId          String?
  projectId          String?
  bankAccountId      String?
  amount             Decimal
  currency           String               @default("INR")
  purpose            String
  description        String?
  status             PaymentStatus        @default(CREATED)
  gatewayName        String?
  gatewayOrderId     String?
  gatewayPaymentId   String?
  gatewaySignature   String?
  idempotencyKey     String               @unique
  metadata           Json?
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  FundRelease        FundRelease[]
  bankAccount        BankAccount?         @relation(fields: [bankAccountId], references: [id])
  User               User?                @relation(fields: [createdById], references: [id])
  PaymentTransaction PaymentTransaction[]
  PaymentWebhookLog  PaymentWebhookLog[]

  @@index([orderNumber])
  @@index([status])
  @@index([gatewayOrderId])
}

model UtilizationCertificate {
  id                                                         String                       @id @default(uuid())
  convergenceProjectId                                       String?
  milestoneId                                                String?
  csrFundReleaseId                                           String?
  csrProjectId                                               String?
  csrRequirementId                                           String?
  ngoId                                                      String?
  verifiedById                                               String?
  uploadedByUserId                                           String
  certificateDocumentUrl                                     String
  amountUtilized                                             Decimal                      @db.Decimal(15, 2)
  remarks                                                    String?
  invoiceDocuments                                           String[]
  verificationStatus                                         String                       @default("PENDING")
  verifiedByNodalOfficerId                                   String?
  uploadedAt                                                 DateTime                     @default(now())
  verifiedAt                                                 DateTime?
  ConvergenceProject                                         ConvergenceProject?          @relation(fields: [convergenceProjectId], references: [id], onDelete: Cascade)
  CSRFundRelease                                             CSRFundRelease?              @relation(fields: [csrFundReleaseId], references: [id], onDelete: Cascade)
  CSRProject                                                 CSRProject?                  @relation(fields: [csrProjectId], references: [id], onDelete: Cascade)
  CSRRequirement                                             CSRRequirement?              @relation(fields: [csrRequirementId], references: [id], onDelete: Cascade)
  milestone                                                  ProjectDeliverableMilestone? @relation(fields: [milestoneId], references: [id])
  NGO                                                        NGO?                         @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  User_UtilizationCertificate_uploadedByUserIdToUser         User                         @relation("UtilizationCertificate_uploadedByUserIdToUser", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  User_UtilizationCertificate_verifiedByIdToUser             User?                        @relation("UtilizationCertificate_verifiedByIdToUser", fields: [verifiedById], references: [id])
  User_UtilizationCertificate_verifiedByNodalOfficerIdToUser User?                        @relation("UtilizationCertificate_verifiedByNodalOfficerIdToUser", fields: [verifiedByNodalOfficerId], references: [id])

  @@index([milestoneId])
  @@index([verificationStatus])
  @@index([convergenceProjectId])
  @@index([uploadedByUserId])
}

model Grievance {
  id                                           String               @id @default(uuid())
  grievanceId                                  String               @unique
  convergenceProjectId                         String
  raisedByUserId                               String
  raisedByType                                 String
  issueTitle                                   String
  issueDescription                             String
  status                                       GrievanceStatus      @default(RAISED)
  level1DueAt                                  DateTime?
  level2DueAt                                  DateTime?
  assignedNodalOfficerId                       String?
  assignedStateCellUserId                      String?
  finalAuthorityUserId                         String?
  resolutionText                               String?
  createdAt                                    DateTime             @default(now())
  updatedAt                                    DateTime             @updatedAt
  User_Grievance_assignedNodalOfficerIdToUser  User?                @relation("Grievance_assignedNodalOfficerIdToUser", fields: [assignedNodalOfficerId], references: [id])
  User_Grievance_assignedStateCellUserIdToUser User?                @relation("Grievance_assignedStateCellUserIdToUser", fields: [assignedStateCellUserId], references: [id])
  ConvergenceProject                           ConvergenceProject   @relation(fields: [convergenceProjectId], references: [id], onDelete: Cascade)
  User_Grievance_finalAuthorityUserIdToUser    User?                @relation("Grievance_finalAuthorityUserIdToUser", fields: [finalAuthorityUserId], references: [id])
  raisedByUser                                 User                 @relation("GrievancesRaised", fields: [raisedByUserId], references: [id], onDelete: Cascade)
  actionLogs                                   GrievanceActionLog[]

  @@index([status])
  @@index([raisedByUserId])
  @@index([assignedNodalOfficerId])
  @@index([convergenceProjectId])
  @@index([grievanceId])
}

model GrievanceActionLog {
  id          String    @id @default(uuid())
  grievanceId String
  actorUserId String
  action      String
  note        String
  createdAt   DateTime  @default(now())
  actorUser   User      @relation("GrievanceActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([grievanceId])
  @@index([actorUserId])
}

model ProjectInspection {
  id                String         @id @default(uuid())
  csrProjectId      String?
  csrRequirementId  String
  districtOfficerId String?
  visitDate         DateTime
  latitude          Float?
  longitude         Float?
  geoTaggedImages   String[]
  remarks           String?
  issuesFound       String?
  actionRequired    String?
  nextVisitDate     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  CSRProject        CSRProject?    @relation(fields: [csrProjectId], references: [id], onDelete: Cascade)
  CSRRequirement    CSRRequirement @relation(fields: [csrRequirementId], references: [id], onDelete: Cascade)

  @@index([csrProjectId])
  @@index([csrRequirementId])
  @@index([districtOfficerId])
  @@index([visitDate])
}

model StandardMou {
  id                        String              @id @default(uuid())
  mouReferenceId            String              @unique
  corporateEnquiryId        String?             @unique
  governmentPitchId         String?             @unique
  projectId                 String?             @unique
  districtDepartmentName    String
  nodalOfficerName          String
  corporateName             String
  cin                       String
  projectTitle              String
  projectDescription        String
  scheduleVIIClause         String
  projectLocation           String
  deliverables              Json
  timelineMonths            Int
  financialContribution     Decimal             @db.Decimal(15, 2)
  governmentContribution    Decimal?            @db.Decimal(15, 2)
  implementationMode        String
  implementingAgencyName    String?
  ownershipAfterCompletion  String
  maintenanceResponsibility String
  signedDocumentUrl         String?
  status                    String              @default("DRAFT")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  ConvergenceProject        ConvergenceProject?
  CorporateEnquiry          CorporateEnquiry?   @relation(fields: [corporateEnquiryId], references: [id])
  GovernmentPitch           GovernmentPitch?    @relation(fields: [governmentPitchId], references: [id])

  @@index([mouReferenceId])
  @@index([status])
}

model ProjectAssignment {
  id             String            @id @default(uuid())
  entityType     String
  entityId       String
  assignmentType String
  assignedById   String
  assignedToId   String
  assignedRoleId String?
  status         String            @default("ACTIVE")
  remarks        String?
  companyId      String?
  assignedAt     DateTime          @default(now())
  revokedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  assignedBy     User              @relation("AssignedByUser", fields: [assignedById], references: [id])
  assignedRole   OrganizationRole? @relation(fields: [assignedRoleId], references: [id])
  assignedTo     User              @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: Cascade)

  @@index([entityId, entityType])
  @@index([assignedById])
  @@index([assignedToId, status])
}

model DistrictNodalMapping {
  id           String   @id @default(uuid())
  district     String
  domain       String?
  userId       String
  isActive     Boolean  @default(true)
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  assignedBy   User     @relation("AssignedByNodalUser", fields: [assignedById], references: [id])
  user         User     @relation("NodalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([district, isActive])
  @@index([userId])
}

model HelpdeskQuery {
  id               String    @id @default(uuid())
  trackingId       String    @unique
  subject          String
  message          String
  name             String
  email            String
  mobile           String?
  status           String    @default("OPEN")
  resolution       String?
  raisedByUserId   String?
  resolvedByUserId String?
  resolutionDueAt  DateTime
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  raisedByUser     User?     @relation("HelpdeskRaised", fields: [raisedByUserId], references: [id])
  resolvedByUser   User?     @relation("HelpdeskResolved", fields: [resolvedByUserId], references: [id])

  @@index([status])
  @@index([email])
