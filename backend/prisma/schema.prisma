  status      String    @default("DRAFT")
  documentUrl String?
  signedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

model MatchScore {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  score          Float
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
}

model Chat {
  id        String    @id @default(uuid())
  title     String?
  projectId String?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([projectId])
}

model Message {
  id           String   @id @default(uuid())
  chatId       String
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderUserId String?
  senderId     String?
  sender       User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  content      String   @db.Text
  readBy       String[]
  createdAt    DateTime @default(now())

  @@index([chatId])
  @@index([senderUserId])
}

// =============================================================================
// IMPLEMENTING AGENCY SUB-LOGIN ENGINE (Corporate Company Sub-Logins)
// =============================================================================

model AgencySubLogin {
  id             String       @id @default(uuid())
  organizationId String // Belongs exclusively to Corporate Company (Company Admin)
  organization   Organization @relation("OrganizationSubLogins", fields: [organizationId], references: [id], onDelete: Cascade)

  ngoName                  String
  agencyOrganizationId     String?
  userId                   String?
  createdByUserId          String?
  darpanId                 String?
  email                    String
  loginIdentifier          String?  @unique
  corporateNgoMembershipId String?
  contactPerson            String?
  phone                    String?
  assignedProjectId        String?
  assignedProject          Project? @relation("ProjectAgencySubLogins", fields: [assignedProjectId], references: [id], onDelete: SetNull)

  status    String   @default("ACTIVE") // ACTIVE, INVITE_SENT, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([assignedProjectId])
  @@index([corporateNgoMembershipId])
}

// =============================================================================
// CLIENT-CONSOLIDATED ORGANIZATION, CASE, ASSIGNMENT & NGO ACCESS FOUNDATION
// =============================================================================

model OrganizationMembership {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId          Int?
  membershipType  String
  status          MembershipStatus @default(INVITED)
  invitationId    String?
  invitedByUserId String?
  activatedAt     DateTime?
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, userId, membershipType])
  @@index([userId, status])
  @@index([organizationId, membershipType, status])
}

model GovernmentOnboardingApplication {
  id                String                      @id @default(uuid())
  organizationId    String
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version           Int                         @default(1)
  organizationLevel GovernmentOrganizationLevel
  formData          Json
  documentSnapshot  Json?
  status            String                      @default("DRAFT")
  submittedByUserId String?
  submittedAt       DateTime?
  reviewerRoleCode  String
  reviewedByUserId  String?
  decision          String?
  decisionRemarks   String?                     @db.Text
  decidedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([organizationId, version])
  @@index([reviewerRoleCode, status, submittedAt])
}

model RelationshipManagerProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAvailable       Boolean   @default(true)
  isOutOfOffice     Boolean   @default(false)
  leaveStartsAt     DateTime?
  leaveEndsAt       DateTime?
  maxActiveWorkload Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isAvailable, isOutOfOffice])
}

model RmAllocationCursor {
  poolKey            String   @id
  lastSelectedUserId String?
  sequence           BigInt   @default(0)
  updatedAt          DateTime @updatedAt
}

model PortalCase {
  id                       String                      @id @default(uuid())
  trackingId               String                      @unique
  type                     PortalCaseType
  sourceEntityId           String
  sourcePitchId            String?
  submittingOrganizationId String?
  submittedByUserId        String?
  assignedRmId             String?
  assignedRm               User?                       @relation("PortalCaseAssignedRm", fields: [assignedRmId], references: [id], onDelete: SetNull)
  geographicScope          GeographicScope             @default(SINGLE_DISTRICT)
  targetDistricts          String[]                    @default([])
  currentStage             String
  status                   String
  version                  Int                         @default(1)
  firstContactedAt         DateTime?
  lastInteractionAt        DateTime?
  closedAt                 DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  statusHistory            CaseStatusHistory[]
  interactions             CaseInteraction[]
  assessments              CaseFeasibilityAssessment[]
  rmAllocations            RmAllocationEvent[]
  governmentAssignments    GovernmentAssignment[]

  @@unique([type, sourceEntityId])
  @@index([assignedRmId, status])
  @@index([currentStage, status])
  @@index([submittingOrganizationId, type])
}

model CaseStatusHistory {
  id          String     @id @default(uuid())
  caseId      String
  case        PortalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  version     Int
  fromStatus  String?
  toStatus    String
  stage       String
  action      String
  actorUserId String?
  remarks     String?    @db.Text
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@unique([caseId, version])
  @@index([caseId, createdAt])
}

model CaseInteraction {
  id               String     @id @default(uuid())
  caseId           String
  case             PortalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorUserId      String
  interactionType  String
  participants     Json
  summary          String     @db.Text
  budgetDiscussion String?    @db.Text
  notes            String?    @db.Text
  attachmentUrls   String[]   @default([])
  occurredAt       DateTime
  createdAt        DateTime   @default(now())

  @@index([caseId, occurredAt])
  @@index([actorUserId])
}

model CaseFeasibilityAssessment {
  id                 String     @id @default(uuid())
  caseId             String
  case               PortalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  version            Int
  checklist          Json
  recommendation     String
  executiveSummary   String?    @db.Text
  targetDistricts    String[]   @default([])
  targetDepartmentId String?
  conditions         Json?
  assessedByUserId   String
  status             String     @default("DRAFT")
  submittedAt        DateTime?
  jsDecision         String?
  jsDecisionReason   String?    @db.Text
  jsDecidedByUserId  String?
  jsDecidedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([caseId, version])
  @@index([status, submittedAt])
}

model RmAllocationEvent {
  id               String     @id @default(uuid())
  caseId           String
  case             PortalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  selectedRmId     String?
  ruleVersion      String
  workloadSnapshot Json
  tieCandidateIds  String[]   @default([])
  cursorBefore     String?
  cursorAfter      String?
  outcome          String
  createdAt        DateTime   @default(now())

  @@index([caseId, createdAt])
  @@index([selectedRmId, createdAt])
}

model GovernmentAssignment {
  id                       String                      @id @default(uuid())
  caseId                   String
  case                     PortalCase                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  projectId                String?
  ownershipLevel           String
  governmentOrganizationId String?
  governmentOrganization   Organization?               @relation("GovernmentAssignmentOrganization", fields: [governmentOrganizationId], references: [id], onDelete: SetNull)
  primaryNodalUserId       String?
  stateNodalUserId         String?
  csrCellHeadUserId        String?
  status                   String                      @default("PENDING")
  assignmentLetterUrl      String?
  assignmentLetterHash     String?
  letterTemplateVersion    String?
  assignedByUserId         String
  assignedAt               DateTime                    @default(now())
  acceptedAt               DateTime?
  closedAt                 DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  districtAssignments      ProjectDistrictAssignment[]
  dncLinks                 GovernmentAssignmentDnc[]
  events                   GovernmentAssignmentEvent[]

  @@index([caseId, status])
  @@index([governmentOrganizationId, status])
  @@index([primaryNodalUserId, status])
}

model ProjectDistrictAssignment {
  id                       String               @id @default(uuid())
  governmentAssignmentId   String
  governmentAssignment     GovernmentAssignment @relation(fields: [governmentAssignmentId], references: [id], onDelete: Cascade)
  projectId                String?
  district                 String
  governmentOrganizationId String?
  nodalUserId              String?
  assignedByUserId         String
  status                   String               @default("PENDING")
  rejectionReason          String?              @db.Text
  assignedAt               DateTime             @default(now())
  acceptedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@unique([governmentAssignmentId, district])
  @@index([nodalUserId, status])
}

model GovernmentAssignmentDnc {
  id                     String               @id @default(uuid())
  governmentAssignmentId String
  governmentAssignment   GovernmentAssignment @relation(fields: [governmentAssignmentId], references: [id], onDelete: Cascade)
  dncUserId              String
  district               String?
  permissions            String[]             @default([])
  status                 String               @default("ACTIVE")
  linkedByUserId         String
  linkedAt               DateTime             @default(now())

  @@unique([governmentAssignmentId, dncUserId, district])
  @@index([dncUserId, status])
}

model GovernmentAssignmentEvent {
  id                     String               @id @default(uuid())
  governmentAssignmentId String
  governmentAssignment   GovernmentAssignment @relation(fields: [governmentAssignmentId], references: [id], onDelete: Cascade)
  eventType              String
  fromOwnerUserId        String?
  toOwnerUserId          String?
  actorUserId            String
  reasonCode             String?
  remarks                String?              @db.Text
  metadata               Json?
  createdAt              DateTime             @default(now())

  @@index([governmentAssignmentId, createdAt])
}

model CorporateNgoMembership {
  id                      String               @id @default(uuid())
  corporateOrganizationId String
  corporateOrganization   Organization         @relation("CorporateNgoCorporate", fields: [corporateOrganizationId], references: [id], onDelete: Cascade)
  ngoOrganizationId       String
  ngoOrganization         Organization         @relation("CorporateNgoMaster", fields: [ngoOrganizationId], references: [id], onDelete: Cascade)
  contactEmail            String
  status                  String               @default("INVITED")
  invitedByUserId         String
  reviewedByUserId        String?
  reviewRemarks           String?              @db.Text
  approvedAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  accesses                CorporateNgoAccess[]

  @@unique([corporateOrganizationId, ngoOrganizationId])
  @@index([ngoOrganizationId, status])
  @@index([corporateOrganizationId, status])
  @@index([contactEmail])
}

model CorporateNgoAccess {
  id                         String                 @id @default(uuid())
  membershipId               String
  membership                 CorporateNgoMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  userId                     String
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginIdentifier            String                 @unique
  contactEmail               String
  passwordHash               String
  mustResetPassword          Boolean                @default(true)
  temporaryPasswordExpiresAt DateTime?
  tokenVersion               Int                    @default(1)
  projectIds                 String[]               @default([])
  status                     MembershipStatus       @default(INVITED)
  lastContextLoginAt         DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@unique([membershipId, userId])
  @@index([membershipId, status])
  @@index([userId, status])
  @@index([contactEmail])
}
