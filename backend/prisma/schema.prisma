model WorkflowCondition {
  id                 String             @id
  transitionId       String
  field              String
  operator           String
  value              String
  WorkflowTransition WorkflowTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)
}

model WorkflowStage {
  id                                                               String                   @id
  definitionId                                                     String
  name                                                             String
  displayOrder                                                     Int
  slaHours                                                         Int                      @default(24)
  createdAt                                                        DateTime                 @default(now())
  updatedAt                                                        DateTime
  WorkflowAssignmentRule                                           WorkflowAssignmentRule[]
  WorkflowHistory_WorkflowHistory_fromStageIdToWorkflowStage       WorkflowHistory[]        @relation("WorkflowHistory_fromStageIdToWorkflowStage")
  WorkflowHistory_WorkflowHistory_toStageIdToWorkflowStage         WorkflowHistory[]        @relation("WorkflowHistory_toStageIdToWorkflowStage")
  WorkflowInstance                                                 WorkflowInstance[]
  WorkflowRule                                                     WorkflowRule[]
  WorkflowDefinition                                               WorkflowDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  WorkflowTransition_WorkflowTransition_fromStageIdToWorkflowStage WorkflowTransition[]     @relation("WorkflowTransition_fromStageIdToWorkflowStage")
  WorkflowTransition_WorkflowTransition_toStageIdToWorkflowStage   WorkflowTransition[]     @relation("WorkflowTransition_toStageIdToWorkflowStage")
}

